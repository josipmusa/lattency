<idea-plugin>
    <id>dev.lattency.intellij</id>
    <name>Lattency</name>
    <vendor>Josip Musa</vendor>

    <description><![CDATA[
        Marks methods that perform direct or transitive I/O.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
            language="JAVA"
            implementationClass="dev.lattency.intellij.marker.LattencyLineMarkerProvider"/>
        <daemon.changeLocalityDetector
            order="first"
            implementation="dev.lattency.intellij.daemon.LattencyChangeLocalityDetector"/>
    </extensions>
</idea-plugin>
